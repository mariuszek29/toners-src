# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (for AMA-to-content automation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Taostats API (subnet market data)
TAOSTATS_API_KEY=your-taostats-api-key

# Site
NEXT_PUBLIC_SITE_URL=https://taonerds.com

# Optional: comma-separated admin account emails. If unset, any signed-in user can access /admin.
ADMIN_EMAILS=you@example.com

# Cron
CRON_SECRET=generate-a-random-secret
